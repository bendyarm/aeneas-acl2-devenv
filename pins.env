# The ONLY place versions are pinned. Edit here, commit, and CI rebuilds.
# (The Dockerfile carries the same values as defaults so a plain
#  `docker build .` with no arguments builds exactly this.)

# bendyarm/charon: aeneas's charon-pin + the mono carve-out commits
CHARON_REPO=https://github.com/bendyarm/charon
CHARON_COMMIT=58b7d543566f212cd2dabd723b06ccc23ea34075

# bendyarm/aeneas branch acl2-backend
AENEAS_REPO=https://github.com/bendyarm/aeneas
AENEAS_REF=acl2-backend
AENEAS_COMMIT=23cf8c88b7a13ee26b3c6bea772d494b98ef64ce

# ACL2 + certified books: Kestrel's published image (tag = acl2 commit)
KCERTS_IMAGE=ghcr.io/kestrelinstitute/acl2-kcerts:master-0612757

# OCaml compiler for the opam switch (aeneas's flake uses 5.2; 5.3 works)
OCAML_VERSION=5.3.0
